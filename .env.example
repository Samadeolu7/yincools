# ============================================================
#  Yincools (AC Tech Tracker) -- Environment Variables
#  Copy to /opt/java-app/Yincools/.env on the server.
#  Do NOT commit the real .env to git.
# ============================================================

# --- Traefik routing -- REQUIRED, no defaults ---
# Domain Traefik should route to this app, e.g. actech.yourdomain.com
TRAEFIK_DOMAIN=set-me.example.com
# Docker network your Traefik container is attached to (NOT Bank-Recon's
# internal-only phoenix_kti_backend -- this must be the network Traefik
# itself listens on for routing decisions).
TRAEFIK_NETWORK=set-me
# Cert resolver name from Traefik's own static config (only if you don't
# use its default -- leave unset to use "letsencrypt").
TRAEFIK_CERT_RESOLVER=letsencrypt

# --- App secrets -- REQUIRED, no insecure defaults in prod ---
# Dad's PIN. Numeric, whatever length you like.
APP_PIN=set-me
# Random long string signing the remember-me cookie. Generate with:
#   openssl rand -hex 32
APP_REMEMBER_ME_KEY=set-me

# --- Database (dedicated container, started by this compose file) ---
POSTGRES_DB=yincools
POSTGRES_USER=yincools
POSTGRES_PASSWORD=set-me

# --- Image ---
# Override to pin a specific image/SHA instead of :latest
DOCKER_IMAGE=samadeolu7/yincools:latest
